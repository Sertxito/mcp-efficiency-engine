{
  "name": "mcp-efficiency-engine",
  "version": "0.1.43",
  "description": "Local-first engineering harness platform for GitHub Copilot projects",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "mcpee": "./packages/cli/bin/mcpee.js",
    "mcp-efficiency-engine": "./packages/cli/bin/mcpee.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sertxito/mcp-efficiency-engine.git"
  },
  "homepage": "https://github.com/Sertxito/mcp-efficiency-engine#readme",
  "bugs": {
    "url": "https://github.com/Sertxito/mcp-efficiency-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "agents/",
    "catalog/",
    "docs/ARCHITECTURE.md",
    "docs/BOOST-CAPABILITY-COVERAGE.md",
    "docs/BROWNFIELD-SPECS.md",
    "docs/CATALOG.md",
    "docs/COMMANDS.md",
    "docs/COPILOT-EXECUTION.md",
    "docs/DEVELOPMENT.md",
    "docs/GETTING-STARTED.md",
    "docs/KNOWLEDGE.md",
    "docs/OBSERVABILITY.md",
    "docs/QUALITY-AND-EVALUATION.md",
    "docs/SPECIALIST-ACCEPTANCE.md",
    "docs/TROUBLESHOOTING.md",
    "docs/RELEASING.md",
    "instructions/",
    "packages/",
    "patterns/",
    "playbooks/",
    "prompts/",
    "schemas/",
    "skills/",
    "templates/",
    "workflows/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:runtime": "node scripts/build-copilot-runtime.js",
    "pretest": "npm run build:runtime",
    "prepack": "npm run build:runtime",
    "test": "node --test",
    "init": "node packages/cli/bin/mcpee.js init",
    "pack:check": "npm run build:runtime && node scripts/check-package.js",
    "audit:dependencies": "npm audit --audit-level=low",
    "docs:check-links": "node scripts/check-doc-links.js",
    "docs:check-official-links": "node scripts/check-official-links.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "github-copilot",
    "harness",
    "local-first",
    "memory",
    "observability"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "zod": "4.6.7",
    "koffi": "3.2.1"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.26",
    "esbuild": "0.28.2"
  },
  "optionalDependencies": {
    "@github/copilot-sdk-darwin-arm64": "1.0.26",
    "@github/copilot-sdk-darwin-x64": "1.0.26",
    "@github/copilot-sdk-linux-arm64": "1.0.26",
    "@github/copilot-sdk-linux-x64": "1.0.26",
    "@github/copilot-sdk-linuxmusl-arm64": "1.0.26",
    "@github/copilot-sdk-linuxmusl-x64": "1.0.26",
    "@github/copilot-sdk-win32-arm64": "1.0.26",
    "@github/copilot-sdk-win32-x64": "1.0.26"
  },
  "overrides": {
    "@github/copilot-sdk": {
      "zod": "$zod"
    }
  },
  "allowScripts": {
    "koffi@3.2.1": true
  }
}
