{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmitOnError": true,
    "outDir": ".generated",
    "rootDir": "src"
  },
  "include": ["src/**/*.tsx"]
}
