{
  "output": {
    "filePath": "-",
    "style": "markdown",
    "copyToClipboard": false,
    "git": {
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.env",
      "**/.env.*",
      "**/.ssh/**",
      "**/.aws/**",
      "**/.azure/**",
      "**/.gnupg/**",
      "**/.kube/**",
      "**/.docker/**",
      "**/.npmrc",
      "**/.pypirc",
      "**/.netrc",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/id_rsa",
      "**/id_dsa",
      "**/id_ecdsa",
      "**/id_ed25519",
      "**/secrets/**",
      "**/credentials/**",
      "**/certificates/**",
      "**/private/**",
      "**/.mcpee/**",
      "**/node_modules/**",
      "**/.git/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
